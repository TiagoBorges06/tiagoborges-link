---
import WhatsAppButton from "./WhatsAppButton.astro";
---

<section class="relative min-h-screen flex items-center pt-16 overflow-hidden">
  <!-- Background effects -->
  <div class="absolute inset-0 pointer-events-none">
    <div data-parallax="-0.08" class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-purple/10 rounded-full blur-[120px]"></div>
    <div data-parallax="-0.12" class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-tech-blue/8 rounded-full blur-[100px]"></div>
    <div data-parallax="-0.05" class="absolute top-1/3 left-0 w-[300px] h-[300px] bg-cyan/5 rounded-full blur-[100px]"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-20 md:py-32">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
      <!-- Text -->
      <div class="order-2 md:order-1">
        <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-1.5 mb-6 animate-fade-up-delay-1">
          <span class="w-2 h-2 bg-whatsapp rounded-full animate-pulse"></span>
          <span class="text-sm text-gray">Disponível para novos projetos</span>
        </div>

        <!-- Credibility bar -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray mb-4 animate-fade-up-delay-1">
          <span class="flex items-center gap-1.5">
            <span class="w-1 h-1 rounded-full bg-purple"></span>
            20+ projetos entregues
          </span>
        </div>

        <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl leading-tight mb-6 animate-fade-up-delay-2">
          Automatizo processos e crio sites que
          <span class="bg-gradient-to-r from-purple to-cyan bg-clip-text text-transparent">
            geram resultado
          </span>
        </h1>

        <p class="text-lg sm:text-xl text-gray leading-relaxed mb-8 max-w-lg animate-fade-up-delay-3">
          Chega de perder tempo com tarefas repetitivas e clientes esperando resposta. Transformo tecnologia em crescimento real para o seu negócio.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 animate-fade-up-delay-4">
          <WhatsAppButton />
          <a
            href="#servicos"
            class="inline-flex items-center justify-center gap-2 font-display font-semibold text-white border border-white/20 rounded-full px-8 py-4 text-lg hover:bg-white/5 transition-all duration-300 whitespace-nowrap"
          >
            Ver Serviços
          </a>
        </div>
      </div>

      <!-- Photo -->
      <div class="order-1 md:order-2 flex justify-center animate-fade-up-delay-2">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-purple to-tech-blue rounded-full blur-2xl opacity-30 scale-110"></div>
          <!-- Animated decorative ring -->
          <div class="absolute -inset-3 rounded-full border border-dashed border-purple/30 animate-spin-slow"></div>
          <div class="relative w-48 h-48 sm:w-64 sm:h-64 lg:w-80 lg:h-80 rounded-full overflow-hidden border-4 border-white/10">
            <img
              src="/foto-perfil.png"
              alt="Tiago Borges - CTO e Desenvolvedor"
              width="320"
              height="320"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
          <!-- Floating badge -->
          <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 bg-base/90 backdrop-blur-sm border border-white/10 rounded-full px-4 py-1.5 text-xs font-display font-semibold whitespace-nowrap">
            <span class="bg-gradient-to-r from-purple to-cyan bg-clip-text text-transparent">CTO & Dev</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
