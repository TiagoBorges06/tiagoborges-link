---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/5 py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid sm:grid-cols-3 gap-8 mb-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-9 h-9 flex-shrink-0" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="footerLogoGrad" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#7b2cbf"/>
                <stop offset="100%" stop-color="#00d4ff"/>
              </linearGradient>
            </defs>
            <path d="M5 50 L30 15 L38 21 L16 50 L38 79 L30 85 Z" fill="url(#footerLogoGrad)" opacity="0.7"/>
            <path d="M95 50 L70 15 L62 21 L84 50 L62 79 L70 85 Z" fill="url(#footerLogoGrad)"/>
            <rect x="38" y="32" width="24" height="5" rx="2.5" fill="white"/>
            <rect x="48" y="32" width="5" height="42" rx="2.5" fill="white"/>
            <circle cx="80" cy="78" r="4.5" fill="#00d4ff"/>
          </svg>
          <span class="font-display font-bold text-white">Tiago Borges</span>
        </div>
        <p class="text-gray text-sm">
          CTO | Simplifico tecnologia para empresários
        </p>
      </div>

      <!-- Links -->
      <div>
        <h4 class="font-display font-semibold text-sm mb-3">Navegação</h4>
        <ul class="space-y-2">
          <li><a href="#servicos" class="text-gray text-sm hover:text-white transition-colors">Serviços</a></li>
          <li><a href="#cases" class="text-gray text-sm hover:text-white transition-colors">Cases</a></li>
          <li><a href="#processo" class="text-gray text-sm hover:text-white transition-colors">Como Funciona</a></li>
          <li><a href="#faq" class="text-gray text-sm hover:text-white transition-colors">FAQ</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-display font-semibold text-sm mb-3">Contato</h4>
        <ul class="space-y-2">
          <li>
            <a
              href="https://wa.me/5531997055135?text=Oi%20Tiago!%20Vi%20seu%20site%20e%20quero%20saber%20mais%20sobre%20seus%20servi%C3%A7os."
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray text-sm hover:text-whatsapp transition-colors"
            >
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/tiago-borges-137010219"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray text-sm hover:text-tech-blue transition-colors"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href="https://www.instagram.com/tiagoborges.dev"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray text-sm hover:text-purple transition-colors"
            >
              Instagram
            </a>
          </li>
          <li>
            <a href="/links.html" class="text-gray text-sm hover:text-white transition-colors">
              Todos os links
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/5 pt-8 text-center">
      <p class="text-gray/60 text-xs">
        &copy; {currentYear} Tiago Borges. Belo Horizonte, MG.
      </p>
    </div>
  </div>
</footer>
