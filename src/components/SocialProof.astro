---
const stats = [
  { number: "20+", label: "Projetos entregues" },
  { number: "100%", label: "Foco em resultado" },
];

const testimonials = [
  {
    quote: "O Tiago simplificou processos que a gente nem sabia que podiam ser automatizados. Economizamos horas por semana.",
    name: "Ana C.",
    role: "Empresária, Belo Horizonte",
    initials: "AC",
  },
  {
    quote: "Profissional, rápido e entregou além do que pedi. A landing page converteu desde o primeiro dia.",
    name: "Rafael M.",
    role: "Dono de agência",
    initials: "RM",
  },
  {
    quote: "O chatbot que ele criou atende meus clientes 24h. Melhor investimento que fiz no negócio.",
    name: "Juliana S.",
    role: "E-commerce",
    initials: "JS",
  },
];
---

<section class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Stats -->
    <div class="text-center mb-6">
      <span class="inline-block font-display font-semibold text-sm text-purple uppercase tracking-wider fade-in">
        Números que falam
      </span>
    </div>
    <div class="flex flex-wrap justify-center gap-6 mb-20">
      {stats.map((stat, i) => (
        <div data-tilt class={`fade-in stagger-${i + 1} relative text-center p-6 rounded-2xl bg-white/[0.07] border border-white/10 hover:glow-purple transition-all duration-300 w-56`}>
          <div class="font-display font-bold text-3xl sm:text-4xl bg-gradient-to-r from-purple to-cyan bg-clip-text text-transparent mb-2">
            {stat.number}
          </div>
          <div class="text-gray text-sm">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Testimonials -->
    <div>
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-center mb-12 fade-in">
        O que dizem sobre meu trabalho
      </h2>

      <div class="grid md:grid-cols-3 gap-6">
        {testimonials.map((t, i) => (
          <div data-tilt class={`fade-in stagger-${i + 1} relative p-6 rounded-2xl bg-white/[0.07] border border-white/10 hover:border-purple/30 transition-all duration-300`}>
            <div class="flex gap-1 mb-4">
              {[1,2,3,4,5].map(() => (
                <svg class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-gray leading-relaxed mb-4 text-sm">"{t.quote}"</p>
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-gradient-to-br from-purple to-cyan flex items-center justify-center text-xs font-display font-bold text-white flex-shrink-0">
                {t.initials}
              </div>
              <div>
                <div class="font-display font-semibold text-sm">{t.name}</div>
                <div class="text-gray text-xs">{t.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
