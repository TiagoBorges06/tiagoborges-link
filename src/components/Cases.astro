---
import BarChart from "./icons/BarChart.astro";

const cases = [
  {
    title: "Landing Page para Agência",
    before: "Site institucional sem conversões",
    after: "Landing page com 35% de conversão",
    metric: "35%",
    metricLabel: "taxa de conversão",
    tags: ["Landing Page", "SEO", "Performance"],
  },
  {
    title: "Automação de Atendimento",
    before: "4h/dia respondendo mensagens manualmente",
    after: "Chatbot que atende + de 200 clientes/dia",
    metric: "4h → 10min",
    metricLabel: "tempo economizado por dia",
    tags: ["Chatbot", "IA", "WhatsApp"],
  },
  {
    title: "Sistema de Gestão",
    before: "Planilhas espalhadas, dados duplicados",
    after: "Dashboard centralizado com relatórios automáticos",
    metric: "80%",
    metricLabel: "redução de erros",
    tags: ["Dashboard", "API", "Automação"],
  },
];
---

<section id="cases" class="py-20 md:py-28 bg-navy-light/30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16 fade-in">
      <span class="inline-block font-display font-semibold text-sm text-purple uppercase tracking-wider mb-4">
        Cases
      </span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl mb-4">
        Resultados reais de projetos
      </h2>
      <p class="text-gray max-w-2xl mx-auto">
        Veja o antes e depois de projetos que transformaram a operação dos clientes.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {cases.map((c, i) => (
        <div data-tilt class={`fade-in stagger-${i + 1} relative rounded-2xl bg-white/[0.06] border border-white/10 overflow-hidden hover:border-purple/30 transition-all duration-300`}>
          <!-- Gradient bar at top -->
          <div class="h-1 bg-gradient-to-r from-purple via-tech-blue to-cyan"></div>

          <!-- Metric highlight -->
          <div class="p-6 bg-gradient-to-r from-purple/10 to-tech-blue/10 border-b border-white/5">
            <div class="flex items-center gap-3 mb-1">
              <BarChart class="w-5 h-5 text-cyan" />
              <span class="text-gray text-xs uppercase tracking-wider">{c.metricLabel}</span>
            </div>
            <div class="font-display font-bold text-4xl sm:text-5xl bg-gradient-to-r from-purple to-cyan bg-clip-text text-transparent">
              {c.metric}
            </div>
          </div>

          <div class="p-6">
            <h3 class="font-display font-bold text-lg mb-4">{c.title}</h3>

            <div class="space-y-3 mb-4">
              <div class="flex items-start gap-3">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-red-500/10 flex items-center justify-center mt-0.5">
                  <svg class="w-3 h-3 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </span>
                <div>
                  <span class="text-xs text-gray uppercase tracking-wider">Antes</span>
                  <p class="text-sm text-gray">{c.before}</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-whatsapp/10 flex items-center justify-center mt-0.5">
                  <svg class="w-3 h-3 text-whatsapp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <div>
                  <span class="text-xs text-gray uppercase tracking-wider">Depois</span>
                  <p class="text-sm text-white">{c.after}</p>
                </div>
              </div>
            </div>

            <div class="flex flex-wrap gap-2">
              {c.tags.map((tag) => (
                <span class="text-xs px-2 py-1 rounded-full bg-white/5 text-gray">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
