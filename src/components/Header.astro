---
import WhatsAppButton from "./WhatsAppButton.astro";
---

<!-- Mobile menu checkbox (must be outside header for full-screen overlay) -->
<input type="checkbox" id="mobile-menu-toggle" class="hamburger-toggle" aria-label="Abrir menu" />

<header class="fixed top-0 left-0 right-0 z-50 bg-base/80 backdrop-blur-lg border-b border-white/5">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <svg class="w-10 h-10 flex-shrink-0" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="logoGrad" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#7b2cbf"/>
            <stop offset="100%" stop-color="#00d4ff"/>
          </linearGradient>
        </defs>
        <path d="M5 50 L30 15 L38 21 L16 50 L38 79 L30 85 Z" fill="url(#logoGrad)" opacity="0.7"/>
        <path d="M95 50 L70 15 L62 21 L84 50 L62 79 L70 85 Z" fill="url(#logoGrad)"/>
        <rect x="38" y="32" width="24" height="5" rx="2.5" fill="white"/>
        <rect x="48" y="32" width="5" height="42" rx="2.5" fill="white"/>
        <circle cx="80" cy="78" r="4.5" fill="#00d4ff"/>
      </svg>
      <span class="font-display font-bold text-white text-lg hidden sm:block">
        Tiago Borges
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="#servicos" class="text-gray text-sm hover:text-white transition-colors">Serviços</a>
      <a href="#cases" class="text-gray text-sm hover:text-white transition-colors">Cases</a>
      <a href="#processo" class="text-gray text-sm hover:text-white transition-colors">Como Funciona</a>
      <a href="#faq" class="text-gray text-sm hover:text-white transition-colors">FAQ</a>
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:block">
      <WhatsAppButton text="WhatsApp" variant="secondary" class="!px-4 !py-2 !text-sm" />
    </div>

    <!-- Mobile hamburger button -->
    <label for="mobile-menu-toggle" class="md:hidden flex items-center justify-center w-10 h-10 cursor-pointer relative z-[60]">
      <div class="hamburger-icon">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </label>
  </div>
</header>

<!-- Mobile menu overlay (full screen, outside header) -->
<nav class="mobile-menu fixed inset-0 top-16 flex-col bg-base backdrop-blur-xl z-[55] px-6 pt-8 pb-12 overflow-y-auto md:!hidden">
  <div class="flex flex-col gap-6">
    <a href="#servicos" class="text-white text-lg font-display font-semibold hover:text-purple transition-colors" onclick="document.getElementById('mobile-menu-toggle').checked = false">
      Serviços
    </a>
    <a href="#cases" class="text-white text-lg font-display font-semibold hover:text-purple transition-colors" onclick="document.getElementById('mobile-menu-toggle').checked = false">
      Cases
    </a>
    <a href="#processo" class="text-white text-lg font-display font-semibold hover:text-purple transition-colors" onclick="document.getElementById('mobile-menu-toggle').checked = false">
      Como Funciona
    </a>
    <a href="#faq" class="text-white text-lg font-display font-semibold hover:text-purple transition-colors" onclick="document.getElementById('mobile-menu-toggle').checked = false">
      FAQ
    </a>
  </div>
  <div class="mt-8 pt-6 border-t border-white/10">
    <WhatsAppButton text="Falar no WhatsApp" class="w-full justify-center" />
  </div>
</nav>
